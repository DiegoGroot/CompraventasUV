// ==========================================
// ENUMS (Dominios de datos)
// ==========================================
Enum estado_usuario {
  inactivo
  activo
  suspendido
}

Enum rol_usuario {
  estudiante
  profesor
  administrador
}

Enum estado_producto {
  disponible
  reservado
  vendido
  oculto
}

Enum estado_reporte {
  pendiente
  revisado
  resuelto
}

Enum estado_pedido {
  pendiente
  confirmado
  cancelado
}

// ==========================================
// CATÁLOGOS DEL SISTEMA (NUEVO)
// ==========================================

Table regiones {
  id serial [pk]
  nombre varchar [unique, not null, note: 'Ej. Xalapa, Orizaba-Córdoba, Veracruz']
}

Table facultades {
  id serial [pk]
  region_id int [not null]
  nombre varchar [not null, note: 'Ej. FCQ, FEI, FIME']
}

Table categorias {
  id serial [pk]
  nombre varchar [unique, not null]
  descripcion text
}

// ==========================================
// TABLAS PRINCIPALES
// ==========================================

Table usuarios {
  id uuid [pk]
  username varchar [unique, not null]
  correo_institucional varchar [unique, not null, note: 'Debe pertenecer al dominio UV']
  password_hash varchar [not null]
  rol rol_usuario [default: 'estudiante']
  estado estado_usuario [default: 'inactivo']
  fecha_registro timestamp [default: `now()`]
}

Table tokens_verificacion {
  id uuid [pk]
  usuario_id uuid [not null]
  codigo_otp varchar(6) [not null]
  fecha_expiracion timestamp [not null]
}

Table tiendas {
  id uuid [pk]
  vendedor_id uuid [not null]
  categoria_principal_id int [not null]
  region_id int [not null, note: 'Ubicación base de la tienda']
  facultad_id int [not null]
  nombre varchar [not null]
  descripcion text
  fecha_creacion timestamp [default: `now()`]
}

Table productos {
  id uuid [pk]
  vendedor_id uuid [not null]
  tienda_id uuid [note: 'Nulo si es venta independiente']
  categoria_id int [not null]
  region_id int [not null, note: 'Ubicación de entrega del producto']
  facultad_id int [not null]
  nombre varchar [not null]
  descripcion text
  precio decimal(10,2) [not null]
  stock int [not null, default: 1]
  estado estado_producto [default: 'disponible']
  fecha_publicacion timestamp [default: `now()`]
}

Table imagenes_producto {
  id uuid [pk]
  producto_id uuid [not null]
  url_imagen varchar [not null]
  peso_mb decimal(5,2)
  es_principal boolean [default: false]
}

// ==========================================
// INTERACCIÓN Y COMPRAS
// ==========================================

Table favoritos {
  usuario_id uuid [not null]
  producto_id uuid [not null]
  fecha_agregado timestamp [default: `now()`]
  
  indexes {
    (usuario_id, producto_id) [pk]
  }
}

Table carritos {
  id uuid [pk]
  comprador_id uuid [unique, not null]
  fecha_actualizacion timestamp [default: `now()`]
}

Table items_carrito {
  id uuid [pk]
  carrito_id uuid [not null]
  producto_id uuid [not null]
  cantidad int [not null, default: 1]
}

Table pedidos {
  id uuid [pk]
  comprador_id uuid [not null]
  vendedor_id uuid [not null]
  tienda_id uuid
  total decimal(10,2) [not null]
  estado estado_pedido [default: 'pendiente']
  fecha_pedido timestamp [default: `now()`]
  es_compra_directa boolean [default: false]
}

Table detalles_pedido {
  id uuid [pk]
  pedido_id uuid [not null]
  producto_id uuid [not null]
  cantidad int [not null]
  precio_unitario decimal(10,2) [not null]
}

// ==========================================
// COMUNICACIÓN Y MODERACIÓN
// ==========================================

Table conversaciones {
  id uuid [pk]
  comprador_id uuid [not null]
  vendedor_id uuid [not null]
  producto_id uuid [not null]
  fecha_inicio timestamp [default: `now()`]
}

Table mensajes {
  id uuid [pk]
  conversacion_id uuid [not null]
  remitente_id uuid [not null]
  contenido text [not null]
  fecha_envio timestamp [default: `now()`]
}

Table reportes {
  id uuid [pk]
  denunciante_id uuid [not null]
  producto_id uuid [not null]
  motivo text [not null]
  estado estado_reporte [default: 'pendiente']
  fecha_reporte timestamp [default: `now()`]
}

// ==========================================
// RELACIONES (Foreign Keys)
// ==========================================

Ref: facultades.region_id > regiones.id
Ref: tokens_verificacion.usuario_id > usuarios.id [delete: cascade]

Ref: tiendas.vendedor_id > usuarios.id [delete: cascade]
Ref: tiendas.categoria_principal_id > categorias.id
Ref: tiendas.region_id > regiones.id
Ref: tiendas.facultad_id > facultades.id

Ref: productos.vendedor_id > usuarios.id [delete: cascade]
Ref: productos.tienda_id > tiendas.id [delete: cascade]
Ref: productos.categoria_id > categorias.id
Ref: productos.region_id > regiones.id
Ref: productos.facultad_id > facultades.id
Ref: imagenes_producto.producto_id > productos.id [delete: cascade]

Ref: favoritos.usuario_id > usuarios.id [delete: cascade]
Ref: favoritos.producto_id > productos.id [delete: cascade]

Ref: carritos.comprador_id - usuarios.id [delete: cascade]
Ref: items_carrito.carrito_id > carritos.id [delete: cascade]
Ref: items_carrito.producto_id > productos.id [delete: cascade]

Ref: pedidos.comprador_id > usuarios.id
Ref: pedidos.vendedor_id > usuarios.id
Ref: pedidos.tienda_id > tiendas.id
Ref: detalles_pedido.pedido_id > pedidos.id [delete: cascade]
Ref: detalles_pedido.producto_id > productos.id

Ref: conversaciones.comprador_id > usuarios.id
Ref: conversaciones.vendedor_id > usuarios.id
Ref: conversaciones.producto_id > productos.id
Ref: mensajes.conversacion_id > conversaciones.id [delete: cascade]
Ref: mensajes.remitente_id > usuarios.id

Ref: reportes.denunciante_id > usuarios.id
Ref: reportes.producto_id > productos.id [delete: cascade]