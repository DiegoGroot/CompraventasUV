// Enum definitions
Enum estado_usuario {
  activo
  inactivo
}

Enum rol_usuario {
  estudiante
  profesor
  administrador
}

Enum estado_producto {
  disponible
  reservado
  vendido
  oculto
  agotado
}

Enum estado_pedido {
  pendiente
  confirmado
  cancelado
}

// Catálogos e Infraestructura Base
Table regiones {
  id int [pk, increment]
  nombre varchar(100) [not null]
}

Table facultades {
  id int [pk, increment]
  nombre varchar(100) [not null]
  region_id int [ref: > regiones.id]
}

Table categorias {
  id int [pk, increment]
  nombre varchar(100) [unique, not null]
  descripcion text
}

// Usuarios y Tiendas
Table usuarios {
  id uuid [pk, default: `uuid_generate_v4()`]
  username varchar(50) [unique, not null]
  correo_institucional varchar(255) [unique, not null]
  password_hash varchar(255) [not null]
  region_id int [not null, ref: > regiones.id]
  facultad_id int [not null, ref: > facultades.id]
  rol rol_usuario [default: 'estudiante']
  estado estado_usuario [default: 'inactivo']
  fecha_registro timestamp [default: `now()`]
}

Table tiendas {
  id uuid [pk, default: `uuid_generate_v4()`]
  vendedor_id uuid [not null, ref: > usuarios.id]
  categoria_principal_id int [not null, ref: > categorias.id]
  region_id int [not null, ref: > regiones.id]
  facultad_id int [not null, ref: > facultades.id]
  nombre varchar(255) [not null]
  descripcion text
  imagen_link varchar(255) [note: 'Opcional (NULL)']
  fecha_creacion timestamp [default: `now()`]
}

// Productos e Imágenes
Table productos {
  id uuid [pk, default: `uuid_generate_v4()`]
  vendedor_id uuid [not null, ref: > usuarios.id]
  tienda_id uuid [ref: > tiendas.id, note: 'Opcional. NULL si es independiente']
  categoria_id int [not null, ref: > categorias.id]
  region_id int [not null, ref: > regiones.id]
  facultad_id int [not null, ref: > facultades.id]
  nombre varchar(255) [not null]
  descripcion text
  precio decimal(10,2) [not null]
  stock int [default: 1]
  estado estado_producto [default: 'disponible']
  fecha_publicacion timestamp [default: `now()`]
}

Table imagenes_producto {
  id uuid [pk, default: `uuid_generate_v4()`]
  producto_id uuid [not null, ref: > productos.id]
  url_imagen varchar(255) [not null]
  peso_mb decimal(5,2)
  es_principal boolean [default: false]
}

// Transacciones y Pedidos
Table pedidos {
  id uuid [pk, default: `uuid_generate_v4()`]
  comprador_id uuid [not null, ref: > usuarios.id]
  vendedor_id uuid [not null, ref: > usuarios.id]
  tienda_id uuid [ref: > tiendas.id]
  total decimal(10,2) [not null]
  estado estado_pedido [default: 'pendiente']
  es_compra_directa boolean [default: false]
  fecha_pedido timestamp [default: `now()`]
}

Table detalles_pedido {
  id uuid [pk, default: `uuid_generate_v4()`]
  pedido_id uuid [not null, ref: > pedidos.id]
  producto_id uuid [not null, ref: > productos.id]
  cantidad int [not null]
  precio_unitario decimal(10,2) [not null, note: 'Congelado al momento de compra']
}

// Interacción de Usuarios
Table carrito_items {
  id uuid [pk, default: `uuid_generate_v4()`]
  usuario_id uuid [not null, ref: > usuarios.id]
  producto_id uuid [not null, ref: > productos.id]
  cantidad int [default: 1]
  fecha_agregado timestamp [default: `now()`]
  
  indexes {
    (usuario_id, producto_id) [unique]
  }
}

Table favoritos {
  id uuid [pk, default: `uuid_generate_v4()`]
  usuario_id uuid [not null, ref: > usuarios.id]
  producto_id uuid [not null, ref: > productos.id]
  fecha_agregado timestamp [default: `now()`]

  indexes {
    (usuario_id, producto_id) [unique]
  }
}

Table mensajes {
  id uuid [pk, default: `uuid_generate_v4()`]
  remitente_id uuid [not null, ref: > usuarios.id]
  receptor_id uuid [not null, ref: > usuarios.id]
  producto_id uuid [not null, ref: > productos.id]
  contenido text [not null]
  leido boolean [default: false]
  fecha_envio timestamp [default: `now()`]
}